{
  "name": "@axentra/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/server.ts",
    "start": "bun --env-file=../../.env src/server.ts",
    "build": "bun build src/server.ts --outdir dist --target bun",
    "type-check": "tsc --noEmit",
    "test": "bun test src"
  },
  "dependencies": {
    "@axentra/config": "workspace:*",
    "@axentra/db": "workspace:*",
    "@axentra/observability": "workspace:*",
    "@axentra/queue": "workspace:*",
    "@axentra/shared": "workspace:*",
    "@axentra/storage": "workspace:*",
    "hono": "^4.0.0",
    "zod": "^4.0.0"
  }
}
