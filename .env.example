# Copy to .env for local development. Values below are local-only placeholders.

APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=debug

# Web
VITE_API_BASE_URL=/api/v1

# API
API_PORT=3001
API_SHUTDOWN_TIMEOUT_MS=15000
REDIS_HEALTH_TIMEOUT_MS=1500

# Database
DATABASE_URL=postgres://axentra:local-postgres-password@localhost:5432/axentra

# Redis and queue
REDIS_URL=redis://localhost:6379/0
QUEUE_NAME=axentra-jobs
WORKER_CONCURRENCY=2
WORKER_SHUTDOWN_TIMEOUT_MS=15000

# S3-compatible object storage. These are MinIO-only local placeholders.
S3_PROVIDER=minio
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-southeast-3
S3_BUCKET=axentra-local
S3_ACCESS_KEY_ID=local-minio-user
S3_SECRET_ACCESS_KEY=local-minio-password
S3_FORCE_PATH_STYLE=true

# Production uses the assigned private bucket through secure infrastructure config:
# S3_PROVIDER=s3
# S3_ENDPOINT=
# S3_REGION=ap-southeast-3
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
